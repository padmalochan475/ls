rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    // Check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }
    
    // Helper function to safely get the current user's profile data
    function getUserData() {
      return isAuth() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }
    
    // Check if user is Admin safely (prevents evaluation crash for new users)
    function isAdmin() {
      let data = getUserData();
      return data != null && data.get('role', '') == 'admin';
    }

    // --- Collection Rules ---

    // 1. Master Data Collections
    // Everyone (Auth) can READ to populate dropdowns.
    // Only ADMIN can WRITE (Add/Edit/Delete).
    match /departments/{docId} { allow read: if isAuth(); allow write: if isAdmin(); }
    match /syllabi/{docId}     { allow read: if isAuth(); allow write: if isAdmin(); }
    match /semesters/{docId}   { allow read: if isAuth(); allow write: if isAdmin(); }
    match /subjects/{docId}    { allow read: if isAuth(); allow write: if isAdmin(); }
    match /faculty/{docId} { 
        allow read: if isAuth(); 
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || 
                     (isAuth() && resource.data.uid == request.auth.uid) ||
                     (isAuth() && (!("uid" in resource.data) || resource.data.uid == null) && request.resource.data.uid == request.auth.uid); 
    }
    match /rooms/{docId}       { allow read: if isAuth(); allow write: if isAdmin(); }
    match /groups/{docId}      { allow read: if isAuth(); allow write: if isAdmin(); }
    match /days/{docId}        { allow read: if isAuth(); allow write: if isAdmin(); }
    match /timeslots/{docId}   { allow read: if isAuth(); allow write: if isAdmin(); }

    // 2. Schedule Collection
    // Auth users can READ (View Only).
    // Only ADMIN can CREATE/UPDATE/DELETE.
    match /schedule/{docId} {
      allow read: if isAuth();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 4. User Profiles
    // SECURED: Only authenticated users can read profiles.
    match /users/{userId} {
      allow read: if isAuth();
      
      // SECURED: User creation is strictly handled by the Backend Admin SDK.
      allow create: if false;
      
      // Allow admin to update anything. 
      // Allow users to update their own profile, BUT block changes to sensitive fields.
      allow update: if isAdmin() || (
          isAuth() && request.auth.uid == userId 
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'role', 'accountStatus', 'approvalStatus', 'masterDataLinked', 'empId', 'isAdmin', 'permissions'
          ]))
      );
      
      // Only admins can delete users.
      allow delete: if isAdmin();
      
      // Free Tier Notification System:
      match /notifications/{notifId} {
        allow read: if isAuth() && request.auth.uid == userId;
        allow create: if isAuth() && 
                      request.resource.data.title is string && request.resource.data.title.size() < 150 &&
                      request.resource.data.body is string && request.resource.data.body.size() < 1000;
        allow update: if isAuth() && request.auth.uid == userId; // User can mark as read
        allow delete: if isAuth() && request.auth.uid == userId; // User can delete
      }
    }

    // Secure OTPs and Audit Logs (Backend only)
    match /otps/{id} {
      allow read, write: if false;
    }
    match /audit_logs/{id} {
      allow read, write: if false;
    }

    // 5. Secure Login Lookup
    match /emp_lookups/{empId} {
      allow get: if true;
      allow list: if false;
      // Registration is handled strictly by the backend Admin SDK.
      allow create: if false;
      // Allow update if:
      //   a) Admin updating anything
      //   b) The user who owns this lookup (uid matches)
      //   c) An authenticated user claiming a pre-created (uid=null) lookup by linking their own uid
      allow update: if isAdmin() 
                    || (isAuth() && resource.data.uid == request.auth.uid)
                    || (isAuth() && (resource.data.uid == null || !("uid" in resource.data)) 
                        && request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // 6. Config/Settings
    match /settings/{docId} {
        allow read: if true; // Public access for Active Year config
        allow write: if isAdmin();
    }
    
    // 7. Manual Notifications Outbox
    match /outbox_notifications/{docId} {
        allow create: if isAdmin();
        allow read: if isAdmin();
        allow update: if isAdmin();
    }

    // 8. Suggestions Box
    match /suggestions/{docId} {
        allow create: if isAuth();
        allow read: if isAdmin() || (isAuth() && resource.data.userId == request.auth.uid);
        allow update: if isAdmin();
        allow delete: if isAdmin();
    }
    
    // 9. Celebrations
    match /celebrations/{docId} {
        allow read: if isAuth();
        allow write: if isAdmin();
    }

    // 10. Substitutions & Adjustments
    match /adjustments/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }

    match /substitution_requests/{docId} {
      allow read: if isAuth();
      allow create, update: if isAuth();
      allow delete: if isAdmin() || (isAuth() && resource.data.requesterUid == request.auth.uid && resource.data.status == 'pending');
    }

    // 11. Students
    match /students/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
  }
}
