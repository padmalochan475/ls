rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get the current user's profile data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Helper function to check if the user is an admin
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }
    
    // Helper function to check if the user is a teacher (or admin)
    function isTeacher() {
      return isAuthenticated() && (getUserData().role == 'teacher' || getUserData().role == 'admin');
    }

    // 1. Users Collection
    // Anyone authenticated can read their own user document.
    // Admins can read/write all user documents.
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // 2. Students Collection
    // Teachers and Admins can read student data.
    // Only Admins can modify student records (promotions, edits, adds).
    match /students/{studentId} {
      allow read: if isTeacher();
      allow write: if isAdmin();
    }

    // 3. Faculty / Departments / Subjects / Rooms (Master Data)
    // Teachers need to read these to use the app.
    // Only Admins can modify master data.
    match /faculty/{docId} {
      allow read: if isTeacher();
      allow write: if isAdmin();
    }
    match /departments/{docId} {
      allow read: if isTeacher();
      allow write: if isAdmin();
    }
    match /subjects/{docId} {
      allow read: if isTeacher();
      allow write: if isAdmin();
    }
    match /rooms/{docId} {
      allow read: if isTeacher();
      allow write: if isAdmin();
    }
    match /groups/{docId} {
      allow read: if isTeacher();
      allow write: if isAdmin();
    }
    match /semesters/{docId} {
      allow read: if isTeacher();
      allow write: if isAdmin();
    }
    match /days/{docId} {
      allow read: if isTeacher();
      allow write: if isAdmin();
    }
    match /timeslots/{docId} {
      allow read: if isTeacher();
      allow write: if isAdmin();
    }

    // 4. Schedule
    // Teachers and Admins can read the schedule.
    // Only Admins (or designated schedule managers) can write.
    match /schedule/{scheduleId} {
      allow read: if isTeacher();
      allow write: if isAdmin();
    }

    // 5. Attendance & Adjustments (Substitutions)
    // Teachers can write attendance and request substitutions.
    match /attendance/{docId} {
      allow read, write: if isTeacher();
    }
    match /adjustments/{docId} {
      allow read, write: if isTeacher();
    }

    // 6. Settings (Config, Holidays, Celebration)
    // Settings control the academic year and global toggles.
    // Teachers can read, only Admins can write.
    match /settings/{document=**} {
      allow read: if isTeacher();
      allow write: if isAdmin();
    }
    match /celebrations/{document=**} {
      allow read: if isTeacher();
      allow write: if isAdmin();
    }

    // 7. Suggestions
    // Any authenticated user can create a suggestion.
    // Only admins can update or delete them.
    match /suggestions/{suggestionId} {
      allow read: if isTeacher();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    // 8. Syllabi
    // Any authenticated user can read syllabi. Admins can manage.
    match /syllabi/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
